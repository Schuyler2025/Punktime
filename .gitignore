# ============================================
# Wails项目专用忽略规则
# ============================================

# 构建输出目录
build/
dist/
bin/

# 可执行文件
*.exe
*.dmg
*.AppImage
punktime
Punktime

# 开发工具缓存
.vscode/
.idea/
*.swp
*.swo
*~

# ============================================
# Go语言相关忽略规则
# ============================================

# Go编译输出
*.test
*.out
*.prof

# 依赖包目录
vendor/

# Go工作区文件
go.work
go.work.sum

# ============================================
# 前端相关忽略规则  
# ============================================

# Node.js依赖
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 前端构建输出
frontend/dist/
frontend/build/
*.tgz
*.tar.gz

# 包管理器锁文件（可选，建议保留）
# package-lock.json
# yarn.lock

# ============================================
# 系统文件忽略规则
# ============================================

# 操作系统文件
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# 日志文件
*.log

# 临时文件
*.tmp
*.temp

# ============================================
# 开发环境特定文件
# ============================================

# 环境变量文件（包含敏感信息）
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# 本地配置文件
config.local.*
*.local

# ============================================
# 项目特定忽略规则
# ============================================

# VSCode计数器输出（分析工具生成）
.VSCodeCounter/

# 备份文件
*.bak
*.backup

# 压缩文件
*.zip
*.rar
*.7z